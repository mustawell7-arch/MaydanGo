{
  "expo": {
    "name": "MaydanGO",
    "slug": "maydango",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "maydango",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#f9f7f1"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "MaydanGO uses your camera to scan place check-in codes.",
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MaydanGO uses your location to verify check-in at a partner facility.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ],
      "expo-sharing",
      [
        "@appeeky/expo-healthkit",
        {
          "healthSharePermission": "MaydanGo reads daily step totals and completed-workout counts only, after you allow access in Apple Health.",
          "healthUpdatePermission": false,
          "healthConnectPermissions": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
