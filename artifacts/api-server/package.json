{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "seed:preview": "tsx scripts/seed-preview.ts",
    "seed:super-admin": "export NODE_ENV=development && tsx scripts/seed-super-admin.ts",
    "test:bookings": "tsx --test src/lib/reservations.test.ts",
    "test:checkin": "tsx --test src/lib/checkin.test.ts",
    "test:geo-utils": "tsx --test tests/maydango-location.test.mjs",
    "test:devices": "tsx --test src/lib/member-device-security.test.ts",
    "test:payments": "tsx --test src/lib/payments.test.ts src/routes/payment-webhook.test.ts",
    "test:facilities": "tsx --test src/lib/facility-hours.test.ts",
    "test:support": "tsx --test src/lib/support.test.ts",
    "test:finance": "tsx --test src/routes/finance.test.ts",
    "test:super-admin": "tsx --test src/lib/admin-roles.test.ts src/middlewares/admin-rbac.test.ts src/routes/super-admin.test.ts",
    "test:corporate-agreements": "tsx --test src/routes/corporate-agreements.test.ts",
    "test:waitlist": "tsx --test src/lib/waitlist-schema-migration.test.ts && tsx --test src/lib/waitlist.test.ts && tsx --test src/lib/reservations.test.ts",
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clerk/express": "^2.1.90",
    "@clerk/shared": "^4.45.1",
    "@google-cloud/storage": "^8.4.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.3.0",
    "http-proxy-middleware": "^4.2.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.2.0",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
